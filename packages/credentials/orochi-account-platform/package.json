{
  "name": "@orochi-network/oh-orochi-account-platform",
  "description": "Authorize Orochi accounts through browser PKCE",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/credentials/orochi-account-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-orochi-account": "workspace:*",
    "@orochi-network/oh-authorization": "workspace:*",
    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-orochi-account": "workspace:*",
    "@orochi-network/oh-authorization": "workspace:*",
    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-host-webserver": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
