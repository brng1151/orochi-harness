{
  "name": "@orochi-network/oh-terminal-bash",
  "description": "Persistent shell PTY backend over the Orochi Harness subprocess terminal primitive",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-terminal": "workspace:*",
    "@orochi-network/oh-sandbox": "workspace:*",
    "@orochi-network/oh-sandbox-policy": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-lazy-require": "workspace:*",
    "@orochi-network/oh-pwsh-local": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-loop-testkit": "workspace:*",
    "@orochi-network/oh-terminal": "workspace:*",
    "@orochi-network/oh-sandbox": "workspace:*",
    "@orochi-network/oh-sandbox-policy": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  }
}
