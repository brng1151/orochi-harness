{
  "name": "@orochi-network/oh-terminal",
  "description": "Persistent PTY session seam for the Orochi Harness — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-loop-testkit": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  }
}
