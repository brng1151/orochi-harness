{
  "name": "@orochi-network/oh-subagent-oh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Orochi Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/subagent/subagent-oh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-sdk-client": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-subagent": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-instructions": "workspace:*",
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-llm-orochi": "workspace:*",
    "@orochi-network/oh-llm-orochi-api-key": "workspace:*",
    "@orochi-network/oh-loader-smoke": "workspace:*",
    "@orochi-network/oh-sdk-client": "workspace:*",
    "@orochi-network/oh-sdk-protocol": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-checkpoint-policy": "workspace:*",
    "@orochi-network/oh-session-persistence-jsonl": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-skill-filesystem": "workspace:*",
    "@orochi-network/oh-subagent": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tool-subagent": "workspace:*"
  }
}
