{
  "name": "@orochi-network/oh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@orochi-network/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-output-retention": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-spill": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-output-retention": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-spill": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-scope": "workspace:*"
  }
}
