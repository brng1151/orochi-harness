{
  "name": "@orochi-network/oh-session",
  "description": "Event-sourced session store for the Orochi Harness",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/core/session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./fork": {
      "types": "./lib/types/fork.d.ts",
      "default": "./lib/types/fork.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./surface": {
      "types": "./lib/types/surface.d.ts",
      "default": "./lib/types/surface.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*",
    "@orochi-network/oh-typert-registry": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  },
  "dependencies": {
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-util-values": "workspace:*"
  }
}
