{
  "name": "@orochi-network/oh-plugin-package-inventory-orochi",
  "description": "Active Loader-backed plugin package inventory for official Orochi LLM API requests",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/llm/plugin-package-inventory-orochi"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-preset-registry": "workspace:*",
    "@orochi-network/oh-orochi-llm-api-extensions": "workspace:*",
    "@orochi-network/oh-session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@orochi-network/oh-agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-include": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-preset-registry": "workspace:*",
    "@orochi-network/oh-orochi-llm-api-extensions": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*"
  }
}
