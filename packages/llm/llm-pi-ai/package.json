    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-fs": "workspace:*",
    "@orochi-network/oh-launch-environment": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-authorization": "workspace:*",
    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-fs": "workspace:*",
    "@orochi-network/oh-launch-environment": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-llm-orochi": "workspace:*",
    "@orochi-network/oh-llm-orochi-api-key": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-http-proxy": "workspace:*",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-settings": "workspace:*"
  },
