{
  "name": "@orochi-network/oh-llm-pi-ai",
  "description": "pi-ai-backed Orochi adapter for the Orochi Harness LLM seam (design-verification twin of oh-llm-orochi)",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
