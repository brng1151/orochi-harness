{
  "name": "@orochi-network/oh-acp-app",
  "description": "The oh ACP profile bundle: automation-only JSON-RPC stdio and process lifecycle over oh-base",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/bundle/acp-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "oh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@orochi-network/oh-acp": "workspace:*",
    "@orochi-network/oh-cmdline": "workspace:*",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis-plugin-include": "workspace:~",
    "@orochi-network/cordis": "workspace:~"
  }
}
