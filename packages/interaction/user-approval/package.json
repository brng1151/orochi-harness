{
  "name": "@orochi-network/oh-user-approval",
  "description": "User-approval seam (ctx.approval) for the Orochi Harness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  },
  "dependencies": {
    "@orochi-network/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/cordis": "workspace:~"
  }
}
