{
  "name": "@orochi-network/oh-tool-lsp",
  "description": "Model-facing lsp tool over the Orochi Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-lsp": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-fs-local": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-lsp": "workspace:*",
    "@orochi-network/oh-lsp-stdio": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-tool-call-timeout-policy": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*"
  }
