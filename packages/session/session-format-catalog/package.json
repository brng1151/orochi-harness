{
  "name": "@orochi-network/oh-session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/session/session-format-catalog"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./lib/types/message-projections.d.ts",
      "default": "./lib/types/message-projections.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@orochi-network/oh-session-format": "workspace:*",
    "@orochi-network/oh-compaction-image-offload": "workspace:*"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-session": "workspace:*"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-session": "workspace:*"
  }
}
